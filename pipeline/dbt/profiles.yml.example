# Copy to profiles.yml in this directory (gitignored) for local use:
#   dbt debug --project-dir pipeline/dbt --profiles-dir pipeline/dbt
#
# Credentials come from environment variables (same DB_* as docker-compose /
# RDS). Swap DB_HOST (and friends) for local vs AWS — no profile edits.
# Never put real passwords in this file.

aq_pipeline:
  target: local
  outputs:
    local:
      type: postgres
      host: "{{ env_var('DB_HOST', 'localhost') }}"
      port: "{{ env_var('DB_PORT', '5432') | as_number }}"
      user: "{{ env_var('DB_USER') }}"
      password: "{{ env_var('DB_PASSWORD') }}"
      dbname: "{{ env_var('DB_NAME') }}"
      schema: analytics
      threads: 4
